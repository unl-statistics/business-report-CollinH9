library(tidyverse)
library(lubridate)
temp <- read_table(
"water_temp.txt",
comment = "#"
)
temp_clean <- temp %>%
mutate(
YY = as.integer(YY),
MM = as.integer(MM),
DD = as.integer(DD),
hh = as.integer(hh),
mm = as.integer(mm),
WTMP = as.numeric(WTMP),
datetime = lubridate::make_datetime(YY, MM, DD, hh, mm),
temp_f = WTMP * 9/5 + 32
) %>%
filter(!is.na(temp_f))
ggplot(temp_clean, aes(datetime, temp_f)) +
geom_line() +
geom_hline(yintercept = 85, linetype = "dashed") +
labs(
title = "Water Temperature at Dauphin Island",
x = "Time",
y = "Temperature (°F)"
)
summary(temp_clean$temp_f)
library(tidyverse)
library(lubridate)
temp <- read_table(
"water_temp.txt",
comment = "#"
)
temp_clean <- temp %>%
mutate(
YY = as.integer(YY),
MM = as.integer(MM),
DD = as.integer(DD),
hh = as.integer(hh),
mm = as.integer(mm),
WTMP = as.numeric(WTMP)
) %>%
filter(
!is.na(WTMP),
WTMP > -5,
WTMP < 40
) %>%
mutate(
datetime = lubridate::make_datetime(YY, MM, DD, hh, mm),
temp_f = WTMP * 9/5 + 32
)
ggplot(temp_clean, aes(datetime, temp_f)) +
geom_line() +
geom_hline(yintercept = 85, linetype = "dashed") +
labs(
title = "Water Temperature at Dauphin Island",
x = "Time",
y = "Temperature (°F)"
)
