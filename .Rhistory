high_temp_periods <- temp_clean %>%
filter(temp_f > 85)
ggplot() +
geom_line(data=temp_clean, aes(datetime,temp_f)) +
geom_rect(
data=high_temp_periods,
aes(xmin=datetime, xmax=datetime,
ymin=-Inf, ymax=Inf),
fill="red", alpha=0.01
)
high_temp <- temp_clean %>%
mutate(high = temp_f > 85)
ggplot(temp_clean, aes(datetime, temp_f)) +
geom_rect(
data = high_temp %>% filter(high),
aes(
xmin = datetime,
xmax = datetime + hours(1),
ymin = -Inf,
ymax = Inf
),
inherit.aes = FALSE,
fill = "red",
alpha = 0.08
) +
geom_line() +
geom_hline(yintercept = 85, linetype = "dashed") +
labs(
title = "Water Temperature at Dauphin Island",
x = "Time",
y = "Temperature (°F)"
)
temp_clean <- temp_clean %>%
mutate(high = temp_f > 85,
group = cumsum(high != lag(high, default = first(high))))
periods <- temp_clean %>%
filter(high) %>%
group_by(group) %>%
summarise(start = min(datetime),
end = max(datetime))
ggplot(temp_clean, aes(datetime, temp_f)) +
geom_rect(
data = periods,
aes(xmin = start, xmax = end,
ymin = -Inf, ymax = Inf),
inherit.aes = FALSE,
fill = "red",
alpha = 0.1
) +
geom_line() +
geom_hline(yintercept = 85, linetype = "dashed")
