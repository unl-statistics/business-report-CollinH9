# convert both to daily values
daily_temp <- temp_clean %>%
mutate(date = as.Date(datetime)) %>%
group_by(date) %>%
summarize(temp = max(temp_f, na.rm = TRUE))
daily_demand <- demand_clean %>%
mutate(date = as.Date(datetime)) %>%
group_by(date) %>%
summarize(demand = mean(demand_mw, na.rm = TRUE))
# combine
plot_data <- left_join(daily_temp, daily_demand, by = "date")
# plot
ggplot(plot_data, aes(x = date)) +
# highlight high temperature days
geom_rect(
data = plot_data %>% filter(temp > 85),
aes(
xmin = date,
xmax = date + 1,
ymin = -Inf,
ymax = Inf
),
inherit.aes = FALSE,
fill = "red",
alpha = 0.08
) +
# temperature line
geom_line(aes(y = temp, color = "Temperature (°F)"), linewidth = 0.7) +
# demand line (scaled)
geom_line(
aes(y = demand / 100, color = "Demand (MW, scaled)"),
linewidth = 0.7
) +
scale_color_manual(values = c("black", "blue")) +
labs(
title = "Water Temperature and Electricity Demand (2025)",
x = "Date",
y = "Temperature (°F) / Demand (scaled)",
color = ""
) +
theme_minimal()
```{r}
# daily temperature
daily_temp <- temp_clean %>%
mutate(date = as.Date(datetime)) %>%
group_by(date) %>%
summarize(temp = max(temp_f, na.rm = TRUE))
# daily demand
daily_demand <- demand_clean %>%
mutate(date = as.Date(datetime)) %>%
group_by(date) %>%
summarize(demand = mean(demand_mw, na.rm = TRUE))
# combine
plot_data <- left_join(daily_temp, daily_demand, by = "date")
# reshape for faceting
plot_long <- plot_data %>%
pivot_longer(
cols = c(temp, demand),
names_to = "variable",
values_to = "value"
)
ggplot(plot_long, aes(date, value)) +
# highlight hot days
geom_rect(
data = plot_data %>% filter(temp > 85),
aes(xmin = date, xmax = date + 1, ymin = -Inf, ymax = Inf),
inherit.aes = FALSE,
fill = "red",
alpha = 0.08
) +
geom_line() +
facet_wrap(~variable, ncol = 1, scales = "free_y") +
labs(
title = "Water Temperature and Electricity Demand",
x = "Date",
y = NULL
) +
theme_minimal()
