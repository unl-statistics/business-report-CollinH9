demand <- read_csv("energy.csv")
head(demand$`Data Date`)
demand_clean <- demand %>%
mutate(
date = mdy(`Data Date`),
hour = as.numeric(`Hour Number`) - 1,
datetime = date + hours(hour),
demand_mw = as.numeric(`Demand (MW)`)
)
demand_clean <- demand_clean %>%
filter(!is.na(datetime), !is.na(demand_mw))
summary(demand_clean$datetime)
summary(demand_clean$demand_mw)
demand_clean %>%
slice(1:100) %>%
ggplot(aes(datetime, demand_mw)) +
geom_line()
summary(demand_clean$demand_mw)
summary(demand_clean$datetime)
ggplot(demand_clean, aes(datetime, demand_mw)) +
geom_line() +
labs(
title = "Electricity Demand Over Time",
x = "Time",
y = "Demand (MW)"
)
# Identify high-temperature dates
high_temp_dates <- temp_clean %>%
filter(temp_f > 85) %>%
mutate(date = as.Date(datetime)) %>%
distinct(date)
# Aggregate daily electricity demand
daily_demand <- demand_clean %>%
mutate(date = as.Date(datetime)) %>%
group_by(date) %>%
summarize(daily_demand_mw = mean(demand_mw, na.rm = TRUE))
# Plot daily demand with high-temperature periods highlighted
ggplot(daily_demand, aes(date, daily_demand_mw)) +
geom_line(color = "blue") +
geom_point(data = daily_demand %>% filter(date %in% high_temp_dates$date),
aes(date, daily_demand_mw), color = "red", size = 1.5) +
labs(
title = "Daily Electricity Demand with High Water Temperature Days Highlighted",
x = "Date",
y = "Demand (MW)"
)
##Electricity Demand Data
The electricity demand dataset contains hourly electricity demand values measured in megawatts (MW) for balancing authorities covering Alabama and the surrounding Southeast region. Demand levels vary throughout the day and across seasons, with higher values typically observed during summer months when cooling demand is higher.
# Read and clean electricity demand data
demand <- read_csv("energy.csv")
demand_clean <- demand %>%
mutate(
date = mdy(`Data Date`),
hour = as.numeric(`Hour Number`) - 1,
datetime = date + hours(hour),
demand_mw = as.numeric(`Demand (MW)`)
) %>%
filter(!is.na(datetime), !is.na(demand_mw))
# Summary statistics for Table 1
demand_summary <- demand_clean %>%
summarize(
min_MW = min(demand_mw),
max_MW = max(demand_mw),
mean_MW = mean(demand_mw),
median_MW = median(demand_mw),
sd_MW = sd(demand_mw)
)
demand_summary
kable(table1, caption = "Summary Statistics for Water Temperature and Electricity Demand")
# Identify high-temperature dates
high_temp_dates <- temp_clean %>%
filter(temp_f > 85) %>%
mutate(date = as.Date(datetime)) %>%
distinct(date)
# Aggregate daily electricity demand
daily_demand <- demand_clean %>%
mutate(date = as.Date(datetime)) %>%
group_by(date) %>%
summarize(daily_demand_mw = mean(demand_mw, na.rm = TRUE))
# Plot daily demand with high-temperature periods highlighted
ggplot(daily_demand, aes(date, daily_demand_mw)) +
geom_line(color = "blue") +
geom_point(data = daily_demand %>% filter(date %in% high_temp_dates$date),
aes(date, daily_demand_mw), color = "red", size = 1.5) +
labs(
title = "Daily Electricity Demand with High Water Temperature Days Highlighted",
x = "Date",
y = "Demand (MW)"
)
