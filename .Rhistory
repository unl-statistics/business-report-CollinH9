round(
temp_clean %>%
mutate(date = as.Date(datetime)) %>%
group_by(date) %>%
summarize(temp = max(temp_f, na.rm = TRUE)) %>%
inner_join(
demand_clean %>%
mutate(date = as.Date(datetime)) %>%
group_by(date) %>%
summarize(demand = mean(demand_mw, na.rm = TRUE)),
by = "date"
) %>%
filter(temp > 85) %>%
pull(demand) %>%
mean(na.rm = TRUE),
0
)
)
)
