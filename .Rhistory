library(tidyverse)
library(lubridate)
temp <- read_table(
"water_temp.txt",
comment = "#"
)
temp_clean <- temp %>%
mutate(
YY = as.integer(YY),
MM = as.integer(MM),
DD = as.integer(DD),
hh = as.integer(hh),
mm = as.integer(mm),
WTMP = as.numeric(WTMP)
) %>%
filter(
!is.na(WTMP),
WTMP > -5,
WTMP < 40
) %>%
mutate(
datetime = lubridate::make_datetime(YY, MM, DD, hh, mm),
temp_f = WTMP * 9/5 + 32
)
demand1 <- read_csv("energy.csv")
demand2 <- read_csv("EIA930_BALANCE_2025_Jul_Dec.csv")
demand <- bind_rows(demand1, demand2)
demand_clean <- demand %>%
mutate(
date = mdy(`Data Date`),
hour = as.numeric(`Hour Number`) - 1,
datetime = date + hours(hour),
demand_mw = as.numeric(`Demand (MW)`)
) %>%
filter(!is.na(datetime), !is.na(demand_mw))
#| label: fig-dauphin-island-temp
#| fig-cap: Hourly water temperature at Dauphin Island in 2025. The dashed line marks the 85°F operational threshold.
ggplot(temp_clean, aes(datetime, temp_f)) +
geom_line() +
geom_hline(yintercept = 85, linetype = "dashed") +
labs(
title = "Water Temperature at Dauphin Island",
x = "Time",
y = "Temperature (°F)"
)
high_temp_dates <- temp_clean %>%
filter(temp_f > 85) %>%
mutate(date = as.Date(datetime)) %>%
distinct(date)
daily_demand <- demand_clean %>%
mutate(date = as.Date(datetime)) %>%
group_by(date) %>%
summarize(daily_demand_mw = mean(demand_mw, na.rm = TRUE))
#| label: fig-dauphin-electricity-demand
#| fig-cap: Daily electricity at Dauphin Island in 2025. The red dots mark days the 85°F operational threshold was exceeded.
ggplot(daily_demand, aes(date, daily_demand_mw)) +
geom_line(color = "blue") +
geom_point(data = daily_demand %>% filter(date %in% high_temp_dates$date),
aes(date, daily_demand_mw), color = "red", size = 1.5) +
labs(
title = "Daily Electricity Demand with High Water Temperature Days Highlighted",
x = "Date",
y = "Demand (MW)"
)
# identify high temp periods
